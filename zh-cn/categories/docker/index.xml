&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code class="language-fallback" data-lang="fallback">&lt;span class="line">&lt;span class="cl">version: &amp;#39;2&amp;#39;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">services:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> zoo:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> image: wurstmeister/zookeeper
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> restart: unless-stopped
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> hostname: zoo
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> ports:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> - &amp;#34;2181:2181&amp;#34;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> container_name: zookeeper
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> kafka:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> image: wurstmeister/kafka
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> ports:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> - &amp;#34;9092:9092&amp;#34;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> environment:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> KAFKA_ADVERTISED_HOST_NAME: 9.134.5.240 ## 修改:宿主机IP
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://9.134.5.240:19092 ## 修改:宿主机IP
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> KAFKA_ZOOKEEPER_CONNECT: &amp;#34;zoo:2181&amp;#34;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> KAFKA_ADVERTISED_PORT: 9092
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> KAFKA_BROKER_ID: 1
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> depends_on:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> - zoo
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> container_name: kafka
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> kafka-manager:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> image: sheepkiller/kafka-manager ## 镜像：开源的web管理kafka集群的界面
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> environment:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> ZK_HOSTS: zoo:2181 ## 修改:宿主机IP
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> ports:
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> - &amp;#34;9000:9000&amp;#34; ## 暴露端口
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
